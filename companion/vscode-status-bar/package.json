{
  "name": "ai-usage-watcher",
  "displayName": "AI Usage Watcher Companion",
  "description": "Live status bar metrics for Claude Code, Antigravity, Codex CLI, Gemini CLI, OpenCode quotas/cost, and Ollama",
  "version": "1.2.3",
  "publisher": "silvkn1",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/silvkn1/ai-usage-watcher#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/silvkn1/ai-usage-watcher.git"
  },
  "keywords": [
    "ai",
    "claude",
    "codex",
    "antigravity",
    "ollama",
    "usage",
    "quota",
    "status-bar"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiUsageWatcher.menu",
        "title": "AI Usage: Quick Actions Menu"
      },
      {
        "command": "aiUsageWatcher.openStatus",
        "title": "AI Usage: Open Status File"
      },
      {
        "command": "aiUsageWatcher.refresh",
        "title": "AI Usage: Refresh Metrics"
      }
    ]
  }
}
